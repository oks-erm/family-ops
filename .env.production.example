# ── Deployment ────────────────────────────────────────────────────────────────
# Your domain (must have DNS A record pointing to the server before first deploy)
DOMAIN=sdfgh.space
SCHEDULING_DOMAIN=lessons.sdfgh.space

# Let's Encrypt notification address
ACME_EMAIL=you@example.com

# GitHub Container Registry image.
# The deploy workflow overwrites this with the current repository image.
GHCR_IMAGE=ghcr.io/oks-erm/family-ops

# Set automatically by the CI/CD pipeline — leave as latest here
IMAGE_TAG=latest

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL itself does not parse DATABASE_URL, so keep these explicit values
# in sync with the username, password, host, port, and database below.
POSTGRES_DB=family_copilot
POSTGRES_USER=family
POSTGRES_PASSWORD=change-me-strong-password

DATABASE_URL=postgresql+asyncpg://family:change-me-strong-password@postgres:5432/family_copilot

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production

PUBLIC_BASE_URL=https://sdfgh.space
SCHEDULING_PUBLIC_BASE_URL=https://lessons.sdfgh.space

# 32+ random characters: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SESSION_SECRET=change-me-with-generated-secret
SESSION_COOKIE_NAME=family_copilot_session
# Share login only across this app's trusted root and lessons subdomains.
SESSION_COOKIE_DOMAIN=.sdfgh.space

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

AI_LIGHT_PROVIDER=deterministic
AI_HEAVY_PROVIDER=openai
AI_REQUEST_TIMEOUT_SECONDS=8

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sdfgh.space/calendar/google/callback
DASHBOARD_GOOGLE_REDIRECT_URI=https://sdfgh.space/auth/google/callback

# ── Scheduling ────────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Europe/Lisbon
SCHEDULING_FEEDBACK_SMTP_USERNAME=
SCHEDULING_FEEDBACK_SMTP_APP_PASSWORD=
SCHEDULING_FEEDBACK_TO_EMAIL=
SCHEDULING_SUPERADMIN_EMAILS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MONTHLY_SUMMARY_TIME=20:00
PLANNING_EVENING_TIME=21:00
MORNING_PLAN_TIME=07:30
EVENING_REVIEW_TIME=21:30
WEEKLY_RECOMMENDATION_TIME=08:00
